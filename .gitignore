/app.new/
/app.old/
/.nomad-update/
update-pending.json
update-result.json
update.log
app/data/*
app/workflows/import_registry.json*
app/images/styles/
app/images/originals/
backups/
.restore-*/

# Seeds ARE versioned (empty on purpose)
!app/data/sfw_characters.json
!app/data/sfw_backgrounds.json
