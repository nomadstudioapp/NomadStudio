{
  "id": "refine.pixel_matcher",
  "label": "Pixel Matcher",
  "category": "refine",
  "group": "styling",
  "description": "Convert any image into crisp pixel art. Auto-detects the ideal grid size and reduces the palette with KMeans clustering. No AI model required — 100% local Python processing.",
  "card_desc": "Turn any photo or illustration into pixel art. Auto-detects grid size, quantises the palette, and optionally scales up the result.",
  "card_tags": [
    "Pixel Art",
    "Local",
    "No AI"
  ],
  "card_css_modifier": "pixel-matcher",
  "llm_required": false,
  "comfyui_required": false,
  "steps": [
    {
      "id": "image",
      "type": "image_picker",
      "label": "Source image",
      "required": true
    },
    {
      "id": "params",
      "type": "workflow_params",
      "label": "Parameters",
      "fields": [
        {
          "id": "auto_detect",
          "adv_key": "auto_detect",
          "label": "Grid size",
          "type": "select",
          "default": "true",
          "options": [
            { "value": "true",  "label": "Auto-detect" },
            { "value": "false", "label": "Manual" }
          ]
        },
        {
          "id": "pixel_size",
          "adv_key": "pixel_size",
          "label": "Pixel size (px)",
          "type": "slider",
          "default": 8,
          "min": 2,
          "max": 32,
          "step": 2,
          "note": "Grid cell size in pixels. Only used when Grid size is set to Manual. Smaller = more detail, larger = blockier."
        },
        {
          "id": "num_colors",
          "adv_key": "num_colors",
          "label": "Palette colours",
          "type": "slider",
          "default": 16,
          "min": 4,
          "max": 256,
          "step": 4
        },
        {
          "id": "scale_factor",
          "adv_key": "scale_factor",
          "label": "Output scale",
          "type": "select",
          "default": "1",
          "options": [
            { "value": "1", "label": "1× (original size)" },
            { "value": "2", "label": "2× upscale" },
            { "value": "4", "label": "4× upscale" },
            { "value": "8", "label": "8× upscale" }
          ]
        },
        {
          "id": "dither",
          "adv_key": "dither",
          "label": "Dithering",
          "type": "select",
          "default": "0",
          "options": [
            { "value": "0", "label": "Off" },
            { "value": "2", "label": "Bayer 2×2" },
            { "value": "4", "label": "Bayer 4×4" },
            { "value": "8", "label": "Bayer 8×8" }
          ],
          "note": "Ordered/retro cross-hatch dithering between adjacent palette colours — not Floyd-Steinberg. Smaller matrix = more pronounced pattern."
        }
      ]
    },
    {
      "id": "generate",
      "type": "action",
      "label": "Convert to Pixel Art",
      "calls": "pixel_match.submit",
      "input_map": {
        "imageDataUrl":   "steps.image.output.image_data_url",
        "advancedValues": "steps.params.output.adv_values"
      }
    },
    {
      "id": "result",
      "type": "result_view",
      "label": "Result",
      "actions": [
        "save",
        "regenerate"
      ]
    }
  ],
  "entry_category": "Pixel Art",
  "entry_model": "Local"
}
